{
  "name": "insurespr-static-site",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic quality tooling for the static InsureSPR site.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:secrets && npm run test:syntax && npm run test:unit && npm run test:deno && npm run test:browser",
    "test:secrets": "node tools/secret-scan.mjs && node --test tools/secret-scan.test.mjs",
    "test:syntax": "node tools/syntax-check.mjs",
    "test:unit": "npm run test:release-audit && npm run test:release-monitor && npm run test:legacy-redirects && npm run test:launch-approvals && npm run test:hpcsa-registration-evidence && npm run test:google-business-profile && npm run test:service-activation-handoff && npm run test:privacy-activation-handoff && npm run test:availability-activation-handoff && npm run test:turnstile-activation-handoff && npm run test:turnstile-provider-inventory && npm run test:notification-activation-handoff && npm run test:recovery-activation-handoff && npm run test:launch-readiness-snapshot && npm run test:recovery && npm run test:concept-preview && npm run test:service-expansion && npm run test:verification-bridge",
    "test:release-audit": "node tools/release-audit.mjs --self-test",
    "test:release-monitor": "node --test tools/release-monitor.test.mjs",
    "test:legacy-redirects": "node --test tools/legacy-redirects.test.mjs",
    "test:launch-approvals": "node --test tools/launch-approvals.test.mjs",
    "test:hpcsa-registration-evidence": "node --test tools/hpcsa-registration-evidence.test.mjs",
    "test:google-business-profile": "node --test tools/google-business-profile.test.mjs",
    "test:service-activation-handoff": "node --test tools/service-activation-handoff.test.mjs",
    "test:privacy-activation-handoff": "node --test tools/privacy-activation-handoff.test.mjs",
    "test:availability-activation-handoff": "node --test tools/availability-activation-handoff.test.mjs",
    "test:turnstile-activation-handoff": "node --test tools/turnstile-activation-handoff.test.mjs",
    "test:turnstile-provider-inventory": "node --test tools/turnstile-provider-inventory.test.mjs",
    "test:notification-activation-handoff": "node --test tools/notification-activation-handoff.test.mjs",
    "test:recovery-activation-handoff": "node --test tools/recovery-activation-handoff.test.mjs",
    "test:launch-readiness-snapshot": "node --test tools/launch-readiness-snapshot.test.mjs",
    "test:recovery": "node --test tools/recovery-backup.test.mjs",
    "test:recovery:docker": "node --test tools/recovery-backup-docker.test.mjs",
    "test:concept-preview": "node --test tools/concept-preview-safety.test.mjs",
    "test:service-expansion": "node tools/service-expansion.test.mjs",
    "test:verification-bridge": "node --test tools/verification-bridge.test.mjs",
    "test:deno": "npm run test:deno:fmt && npm run test:deno:lint && npm run test:deno:check && npm run test:deno:api && npm run test:deno:notifications",
    "test:deno:fmt": "deno fmt --check --config supabase/functions/insurespr-api/deno.json supabase/functions/insurespr-api && deno fmt --check --config supabase/functions/insurespr-notifications/deno.json supabase/functions/insurespr-notifications",
    "test:deno:lint": "deno lint --config supabase/functions/insurespr-api/deno.json supabase/functions/insurespr-api && deno lint --config supabase/functions/insurespr-notifications/deno.json supabase/functions/insurespr-notifications",
    "test:deno:check": "deno check --config supabase/functions/insurespr-api/deno.json supabase/functions/insurespr-api/index.ts supabase/functions/insurespr-api/turnstile.ts supabase/functions/insurespr-api/proxy-attestation.ts supabase/functions/insurespr-api/index.test.ts supabase/functions/insurespr-api/turnstile.test.ts supabase/functions/insurespr-api/proxy-attestation.test.ts && deno check --config supabase/functions/insurespr-notifications/deno.json supabase/functions/insurespr-notifications/index.ts supabase/functions/insurespr-notifications/index.test.ts",
    "test:deno:api": "deno test --allow-env --config supabase/functions/insurespr-api/deno.json supabase/functions/insurespr-api/index.test.ts supabase/functions/insurespr-api/turnstile.test.ts supabase/functions/insurespr-api/proxy-attestation.test.ts",
    "test:deno:notifications": "deno test --allow-env --config supabase/functions/insurespr-notifications/deno.json supabase/functions/insurespr-notifications/index.test.ts",
    "test:browser": "npm run test:form-safety && npm run test:booking-journey && npm run test:accessibility",
    "test:form-safety": "node tools/form-safety.test.mjs",
    "test:booking-journey": "node tools/booking-journey.test.mjs",
    "test:accessibility": "node tools/accessibility-journey.test.mjs",
    "test:performance": "node tools/performance-audit.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
