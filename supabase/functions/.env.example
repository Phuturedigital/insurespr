# Optional comma-separated exact origins in addition to the two official defaults.
# Leave blank in production unless a separately protected origin is approved.
ALLOWED_ORIGINS=

# Use a dedicated random value in production. Until set, the injected server-only
# Supabase secret key is used as the HMAC material and raw IP addresses are never stored.
IP_HASH_PEPPER=

# Optional direct-Edge fallback only. Production Turnstile keys belong in the
# same-origin Vercel bridge described by vercel.env.example. Leave these blank
# unless the direct-Edge architecture is separately approved and tested.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Transactional email stays queued until these are configured and the domain is verified.
RESEND_API_KEY=
EMAIL_FROM="InsureSPR Precision Healthcare <bookings@insuresprhealth.co.za>"
EMAIL_REPLY_TO=motselisi@bonevc.co.za
NOTIFICATION_WORKER_SECRET=
