# Development-only browser audit dependencies. The lockfile is committed so a
# clean clone and CI use the same Playwright release.
node_modules/

# Vercel. .env* covers the .env.local the CLI writes — it holds an OIDC token
# and must never be committed.
.vercel
.env*
!supabase/functions/.env.example

# Playwright + image-pipeline output — ~77MB, all regenerable on demand.
# The scripts under tools/ ARE committed; the pixels they produce are not.
tools/shots/
tools/sheets/
tools/previews/
tools/shots-fe/

# Backups only — assets/ is committed (the shipped site imagery)
*.html.bak

# Encrypted recovery artifacts and restore evidence are operational records,
# never source files. Store them only in approved controlled locations.
*.isprbackup
*.isprbackup.manifest.json
*.restore-evidence.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
